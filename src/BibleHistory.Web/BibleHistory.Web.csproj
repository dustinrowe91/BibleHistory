<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BibleHistory.Web</RootNamespace>
    <UserSecretsId>c906534f-12cf-4370-b086-fea97cbee5a3</UserSecretsId>
  </PropertyGroup>

  <!-- The public site lives at the repository root (so GitHub Pages keeps working). A published build carries a copy
       of it in a "site" folder, which is where Site:Root points outside development. Keep this list in step with
       SiteFiles.IsPublic. -->
  <ItemGroup>
    <None Include="..\..\*.html;..\..\site.css;..\..\site.js;..\..\sw.js;..\..\manifest.webmanifest;..\..\favicon.svg" LinkBase="site" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\icons\**" LinkBase="site\icons" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\studies\**" LinkBase="site\studies" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- Ask's instructions to Claude; the local database folder never ships -->
  <ItemGroup>
    <None Update="Ask\ask-system.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>

</Project>
