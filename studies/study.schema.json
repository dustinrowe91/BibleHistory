{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study.schema.json",
  "title": "Chapter study",
  "description": "One chapter of the Bible worked through the 12-step study method, plus the meta-arc. Verse references inside a chapter use 'v' notation ('3', '3-8'); references elsewhere use full book names ('Numbers 21:8-9').",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "book", "chapter", "title", "status", "source", "updated", "theme", "steps"],
  "properties": {
    "ref": { "type": "string", "pattern": "^[1-3A-Z]{3}\\.[0-9]{1,3}$", "description": "Book code and chapter, e.g. JHN.3" },
    "book": { "type": "string" },
    "chapter": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "description": "A short heading for the chapter, e.g. 'You Must Be Born Again'" },
    "status": { "enum": ["draft", "reviewed"] },
    "source": { "type": "string", "description": "Who or what produced it: 'pilot', a model id, or a reviewer's name" },
    "updated": { "type": "string", "format": "date" },
    "theme": { "type": "string", "description": "The chapter's main point in one or two sentences" },
    "keyVerses": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "usage", "context", "crossRefs", "voices", "translations", "gospel", "application", "misapplications", "contrasts", "features", "summary", "metaArc"],
      "properties": {
        "language": {
          "description": "Step 1. The 3-5 Hebrew, Aramaic or Greek words that carry the chapter.",
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["word", "translit", "gloss", "verses", "note"],
            "properties": {
              "word": { "type": "string", "description": "Lexical form in the original script" },
              "translit": { "type": "string" },
              "strongs": { "type": "string", "pattern": "^[HG][0-9]{1,4}$" },
              "gloss": { "type": "string" },
              "verses": { "type": "string" },
              "note": { "type": "string", "description": "Meaning, form and semantic range, and why it matters here" }
            }
          }
        },
        "usage": {
          "description": "Step 2. Repeated phrases and themes traced through Scripture.",
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["theme", "refs", "note"],
            "properties": {
              "theme": { "type": "string" },
              "refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "context": {
          "description": "Step 3. Where the chapter sits and how it moves.",
          "type": "object", "additionalProperties": false,
          "required": ["setting", "flow"],
          "properties": {
            "setting": { "type": "string" },
            "flow": {
              "type": "array", "minItems": 2, "maxItems": 8,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["verses", "label", "note"],
                "properties": { "verses": { "type": "string" }, "label": { "type": "string" }, "note": { "type": "string" } }
              }
            }
          }
        },
        "crossRefs": {
          "description": "Step 4. Tier 1: Scripture directly interpreting, quoting or fulfilling. Tier 2: strong thematic development. Tier 3: conceptual echoes.",
          "type": "object", "additionalProperties": false,
          "required": ["tier1", "tier2", "tier3"],
          "properties": {
            "tier1": { "$ref": "#/$defs/crossRefList" },
            "tier2": { "$ref": "#/$defs/crossRefList" },
            "tier3": { "$ref": "#/$defs/crossRefList" }
          }
        },
        "voices": {
          "description": "Step 5. What named teachers say, summarized in our own words with the work it comes from. Never a direct quotation.",
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "view"],
            "properties": {
              "name": { "type": "string" },
              "work": { "type": "string", "description": "The book, commentary or sermon the view comes from, if known" },
              "view": { "type": "string" }
            }
          }
        },
        "translations": {
          "description": "Step 6. Key verses where translations differ. KJV text in full (public domain); other versions as a few words each.",
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["verse", "kjv", "renderings", "note"],
            "properties": {
              "verse": { "type": "string" },
              "kjv": { "type": "string" },
              "renderings": {
                "type": "array", "minItems": 2,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["version", "text"],
                  "properties": { "version": { "enum": ["ESV", "NASB", "NIV", "CSB", "KJV", "BSB", "NKJV"] }, "text": { "type": "string", "maxLength": 80 } }
                }
              },
              "note": { "type": "string" }
            }
          }
        },
        "gospel": { "type": "string", "description": "Step 7. How the chapter points to Christ and redemption." },
        "application": {
          "description": "Step 8. Legitimate applications today.",
          "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string" }
        },
        "misapplications": {
          "description": "Step 9. Common misreadings and the correction.",
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["claim", "correction"],
            "properties": { "claim": { "type": "string" }, "correction": { "type": "string" } }
          }
        },
        "contrasts": {
          "description": "Step 10. Theological contrasts in the chapter.",
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["a", "b", "verses", "note"],
            "properties": { "a": { "type": "string" }, "b": { "type": "string" }, "verses": { "type": "string" }, "note": { "type": "string" } }
          }
        },
        "features": {
          "description": "Step 11. Wordplay, irony, structure, covenant language.",
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["label", "note"],
            "properties": { "label": { "type": "string" }, "note": { "type": "string" } }
          }
        },
        "summary": { "type": "string", "description": "Step 12. The chapter's theological significance in a few sentences." },
        "metaArc": {
          "type": "object", "additionalProperties": false,
          "required": ["book", "redemptive"],
          "properties": {
            "book": { "type": "string", "description": "The chapter's role in its book" },
            "redemptive": { "type": "string", "description": "Its place in Creation, Fall, Promise, Redemption, New Creation" }
          }
        }
      }
    }
  },
  "$defs": {
    "crossRefList": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "note"],
        "properties": {
          "ref": { "type": "string" },
          "from": { "type": "string", "description": "The verse in this chapter it connects to" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
